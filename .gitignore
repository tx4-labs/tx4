# TX4 .gitignore
# Suitable for Linux/WSL, macOS, Windows, IDEs, and future Rust / Node toolchains.

# --- Secrets & local env ---
.env
.env.*
!.env.example
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.keystore

# --- OS ---
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
ehthumbs.db
*~

# --- Editors / IDEs ---
.idea/
*.iml
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.code-workspace

# --- Cursor / local agent artifacts (keep project rules if added later) ---
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# --- Logs & temp ---
*.log
logs/
tmp/
temp/
.cache/
*.tmp
*.temp

# --- Coverage / test output ---
coverage/
*.lcov
.nyc_output/
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / TypeScript (future) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# --- Rust (future) ---
target/
**/target/
Cargo.lock.bak
**/*.rs.bk

# --- Python (future tooling) ---
__pycache__/
*.py[cod]
.venv/
venv/
.envrc

# --- Containers / local compose overrides ---
docker-compose.override.yml
*.override.yml

# --- Backup / patch artifacts ---
*.bak
*.orig
*.rej

# --- Local certificates ---
*.crt
*.csr
local-certs/
